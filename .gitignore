# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# production
/build
/logs
/public/dist

# Capacitor native projects — generated by `npm run cap:add:android`/`:ios`
# (see DEPLOY_MOBILE.md) on whichever machine actually has Android
# Studio/Xcode; regenerable from capacitor.config.json, not source.
/android
/ios

# Tauri build output (src-tauri/target) is ignored by src-tauri/.gitignore

# Downloadable app packages served by public/download.html. The two thin
# PWABuilder wrapper (.apk ~1MB) IS committed — at
# that size they cost nothing and a plain `git pull` deploy puts them on the
# server for free. The desktop builds (Tauri) are binaries
# that would grow this repo's history with every release (git never forgets
# a blob). They're reproducible with `npm run desktop:build` and get onto the
# server via scripts/upload-downloads.sh instead.
/public/downloads/*.AppImage
/public/downloads/*.deb
/public/downloads/*.dmg
/public/downloads/*.exe
# Десктоп-сборки Tauri для Windows и macOS (~5–15МБ) — тоже не в git,
# на сервер их кладёт scripts/upload-downloads.sh.
/public/downloads/Shalter-Windows-Setup.exe
/public/downloads/Shalter-Windows.zip
/public/downloads/Shalter-macOS-*.zip

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the template with no secrets in it belongs in the repo, otherwise
# nobody deploying this knows which variables exist.
!.env.example

# runtime SQLite database — this is user data (accounts, messages, calls...),
# not source; the old flat-JSON-file equivalents got committed by mistake in
# this repo's history, don't repeat that with a binary DB file (no meaningful
# diffs, bloats the repo, and it's real user data besides). See DEPLOY.md for
# the actual persistence story (mount /app/data as a volume).
/data/*.db
/data/*.db-wal
/data/*.db-shm
# Ключи шифрования вложений и переписки (server/lib/fileCrypto.js,
# server/lib/textCrypto.js). В репозитории им не место: ключ рядом с кодом
# расшифровывает всё, что лежит на сервере.
/data/*.key
# Uploaded attachments (server/routes/uploads.js) — user data, and gigabytes of it.
/data/uploads/
# Letters written when SMTP isn't configured (server/lib/mailer.js). They hold
# one-time recovery codes in plain text — never commit them.
/data/outbox/
# рабочий каталог RTMP-сервера (эфиры из OBS, server/rtmp.js)
/data/rtmp/

# Старые сборки Electron (до перехода на Tauri) — не для git.
/dist-electron
