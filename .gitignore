# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# production
/build
/logs
/public/dist

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# runtime SQLite database — this is user data (accounts, messages, calls...),
# not source; the old flat-JSON-file equivalents got committed by mistake in
# this repo's history, don't repeat that with a binary DB file (no meaningful
# diffs, bloats the repo, and it's real user data besides). See DEPLOY.md for
# the actual persistence story (mount /app/data as a volume).
/data/*.db
/data/*.db-wal
/data/*.db-shm
