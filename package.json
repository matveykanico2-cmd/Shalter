{
  "name": "shalter",
  "version": "0.2.0",
  "description": "Shalter messenger — desktop shell",
  "author": "Shalter <mtvniko@gmail.com>",
  "private": true,
  "main": "electron/main.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "USE_BUILD=0 nodemon --exec \"node --env-file-if-exists=config.env --env-file-if-exists=.env\" server/index.js",
    "build": "node scripts/build.js",
    "mail-dns": "node scripts/mail-dns.js",
    "start": "NODE_ENV=production node --env-file-if-exists=config.env --env-file-if-exists=.env --max-old-space-size=768 server/index.js",
    "cap:add:android": "npm run build && npx cap add android",
    "cap:add:ios": "npm run build && npx cap add ios",
    "cap:sync": "npm run build && npx cap sync",
    "cap:open:android": "npx cap open android",
    "cap:open:ios": "npx cap open ios",
    "electron:dev": "SHALTER_APP_URL=http://localhost:3000 electron .",
    "electron:build:linux": "electron-builder --linux",
    "electron:build:win": "electron-builder --win",
    "electron:build:mac": "electron-builder --mac",
    "electron:build": "electron-builder -mwl"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.2",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.1",
    "express-static-gzip": "^3.0.1",
    "nodemailer": "^9.0.5",
    "web-push": "^3.6.7",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@capacitor/android": "^7.6.8",
    "@capacitor/cli": "^7.6.8",
    "@capacitor/core": "^7.6.8",
    "@capacitor/ios": "^7.6.8",
    "electron": "^32.3.3",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.28.1",
    "nodemon": "^3.1.9"
  },
  "build": {
    "appId": "ru.shalter.app",
    "productName": "Shalter",
    "directories": {
      "output": "dist-electron"
    },
    "npmRebuild": false,
    "files": [
      "electron/**/*",
      "capacitor.config.json",
      "package.json"
    ],
    "icon": "electron/icon.png",
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "electron/icon.png",
      "artifactName": "Shalter-Setup.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Network",
      "icon": "electron/icon.png",
      "artifactName": "Shalter.${ext}"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "electron/icon.png",
      "artifactName": "Shalter.${ext}",
      "category": "public.app-category.social-networking"
    }
  }
}
