{
  "name": "shalter",
  "version": "1.0.1",
  "description": "Shalter messenger",
  "author": "Shalter <mtvniko@gmail.com>",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "npm run test:contract",
    "dev": "USE_BUILD=0 nodemon --exec \"node --env-file-if-exists=config.env --env-file-if-exists=.env\" server/index.js",
    "build": "node scripts/build.js",
    "mail-dns": "node scripts/mail-dns.js",
    "uploads:to-s3": "node --env-file-if-exists=config.env --env-file-if-exists=.env scripts/migrate-uploads-to-s3.js",
    "s3:cors": "node --env-file-if-exists=config.env --env-file-if-exists=.env scripts/s3-cors.js",
    "loadtest:cleanup": "node --env-file-if-exists=config.env --env-file-if-exists=.env scripts/loadtest-cleanup.js",
    "start": "NODE_ENV=production node --env-file-if-exists=config.env --env-file-if-exists=.env --max-old-space-size=768 server/index.js",
    "cap:add:android": "npm run build && npx cap add android",
    "cap:add:ios": "npm run build && npx cap add ios",
    "cap:sync": "npm run build && npx cap sync",
    "cap:open:android": "npx cap open android",
    "cap:open:ios": "npx cap open ios",
    "desktop:dev": "SHALTER_APP_URL=http://localhost:3000 tauri dev",
    "desktop:build": "tauri build && node scripts/collect-desktop.js",
    "test:unit": "vitest run --config tests/vitest.config.ts unit",
    "test:contract": "vitest run --config tests/vitest.config.ts",
    "test:contract:watch": "vitest --config tests/vitest.config.ts",
    "test:e2e": "playwright test --config tests/playwright.config.ts",
    "test:types": "tsc -p tests/tsconfig.json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1127.0",
    "@aws-sdk/lib-storage": "^3.1127.0",
    "@capacitor-community/contacts": "^7.2.0",
    "@capacitor/browser": "^7.0.5",
    "@capacitor/filesystem": "^7.1.9",
    "@capacitor/keyboard": "^7.0.6",
    "@capacitor/local-notifications": "^7.0.7",
    "@capacitor/push-notifications": "^7.0.7",
    "@capacitor/share": "^7.0.4",
    "@capawesome-team/capacitor-android-foreground-service": "^7.0.1",
    "better-sqlite3": "^13.0.2",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.1",
    "express-static-gzip": "^3.0.1",
    "ffmpeg-static": "^5.3.0",
    "fluent-ffmpeg": "^2.1.3",
    "node-media-server": "^2.7.4",
    "nodemailer": "^9.0.5",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.4",
    "web-push": "^3.6.7",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@capacitor/android": "^7.6.8",
    "@capacitor/cli": "^7.6.9",
    "@capacitor/core": "^7.6.9",
    "@capacitor/ios": "^7.6.8",
    "@playwright/test": "^1.64.1",
    "@tauri-apps/cli": "^2.12.1",
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.1",
    "nodemon": "^3.1.9",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "zod": "^4.6.7"
  }
}
