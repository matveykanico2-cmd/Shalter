{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Shalter",
  "version": "../package.json",
  "identifier": "ru.shalter.app",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage",
      "deb",
      "nsis",
      "app"
    ],
    "category": "SocialNetworking",
    "shortDescription": "Мессенджер Shalter",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Russian",
          "English"
        ]
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "longDescription": "Shalter — мессенджер: личные чаты, группы, каналы, звонки и истории. Приложение для рабочего стола с уведомлениями и значком в трее.",
    "publisher": "Shalter",
    "homepage": "https://shalter.ru",
    "linux": {
      "deb": {
        "section": "net",
        "priority": "optional"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "shalter"
        ]
      }
    }
  }
}
