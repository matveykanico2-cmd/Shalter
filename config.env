# Настройки этого развёртывания, которые едут вместе с репозиторием.
#
# В отличие от .env этот файл НЕ в .gitignore — он коммитится, уезжает на
# GitHub и попадает на сервер обычным git pull, без отдельного копирования.
# Репозиторий публичный, поэтому всё написанное здесь видно всем.
#
# Читает файл само приложение (server/lib/loadConfig.js), а не команда запуска.
# Порядок: config.env, поверх него .env этой машины, поверх обоих — настоящие
# переменные окружения.

# ── Отправка почты (коды восстановления, подтверждение адреса) ───────────────
#
# SMTP намеренно не задан: сервер отдаёт письмо почтовому серверу получателя
# сам (server/lib/directMail.js) и подписывает его ключом домена
# (server/lib/dkim.js). Поручается за отправителя не чужой провайдер, а DNS
# самого домена — три записи, которые показывает Настройки → Модерация →
# «Проверить отправку», с уже подставленными значениями и отметкой, какие из
# них уже опубликованы.
#
# Почему домен shalte.site, а не shalter.ru: к DNS shalter.ru доступа нет, а
# без записей в DNS gmail отклоняет письмо как анонимное — это его правило, а
# не особенность этого кода. У shalte.site редактор DNS доступен, и половина
# нужного там уже стоит (SPF на Timeweb).
MAIL_FROM=Shalter <no-reply@shalte.site>

# Ящик на Яндексе — не заработал: SMTP отвечает "535 5.7.8 This user does not
# have access rights to this service", то есть у аккаунта нет прав на почтовый
# сервис (сам пароль приложения при этом принимается).
# SMTP_URL=smtps://shalter-web%40yandex.com:crrhytodzcbdtjdq@smtp.yandex.com:465

# Ящик на Timeweb — если он когда-нибудь появится, это лучший вариант: за
# подпись отвечает провайдер и записи в DNS не нужны вовсе. Порт 587, а не 465:
# у Timeweb 465 обрывает TLS-рукопожатие, а 587 отвечает "220 smtp.timeweb.ru
# ESMTP" и шифруется через STARTTLS (проверено).
# SMTP_URL=smtp://no-reply%40shalte.site:ПАРОЛЬ@smtp.timeweb.ru:587
PREMIUM_ADMIN_PHONE=+79781827502
PREMIUM_ADMIN_PHONES=+79781824352


# ── Нейросеть бота Hugo (server/lib/hugoAi.js) ───────────────────────────────
#
# Работает из коробки, без ключа и без настройки: по умолчанию Hugo отвечает
# через бесплатный публичный OpenAI-совместимый API Pollinations
# (https://text.pollinations.ai/openai), при его сбое — через их же GET, а если
# нейросеть недоступна или не ответила за таймаут — встроенными ответами.
# Команда «проверь …» по-прежнему идёт в проверку орфографии (LanguageTool).
# В нейросеть уходят только последние ~10 сообщений чата с Hugo.
#
# HUGO_AI=off                        # выключить нейросеть, только правила
# HUGO_AI_URL=https://text.pollinations.ai/openai   # любой /chat/completions; пусто — пропустить
# HUGO_AI_MODEL=openai
# HUGO_AI_GET_URL=https://text.pollinations.ai/    # пусто — без GET-запасного
# HUGO_AI_TIMEOUT_MS=25000           # общий бюджет на всю цепочку
# OLLAMA_URL=http://localhost:11434  # своя локальная модель — пробуется первой
# OLLAMA_MODEL=llama3.2
