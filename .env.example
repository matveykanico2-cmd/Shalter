# Пример файла .env — скопируйте в .env и подставьте свои значения.
# Сам .env в git не попадает (.gitignore), этот пример — попадает.

# Отправка почты (коды восстановления, подтверждение адреса).
# Через обычный ящик: подписывает письма его провайдер, записи в DNS не нужны.
# Адрес в SMTP_URL и в MAIL_FROM должен быть один и тот же — провайдер
# подписывает только свой ящик. Символ @ внутри логина пишется как %40.
SMTP_URL=smtps://логин%40yandex.com:ПАРОЛЬ_ПРИЛОЖЕНИЯ@smtp.yandex.com:465
MAIL_FROM=Shalter <логин@yandex.com>

# Телефон администратора: чей аккаунт с этим номером — тот и админ (см.
# server/config.js). Без этой переменной администратора нет вообще — ни
# Premium выдать, ни забанить, ни попасть в /settings/moderation некому, так
# что для рабочего развёртывания это обязательная строка, не опциональная.
# PREMIUM_ADMIN_PHONE=+79991234567
# Дополнительные администраторы — через запятую, тем же номером формата:
# PREMIUM_ADMIN_PHONES=+79991234568,+79991234569

# TURN-релей для звонков и эфиров (server/lib/turnCredentials.js). Без него
# WebRTC пробует соединиться напрямую через публичный STUN — этого достаточно
# не всегда: за симметричным NAT (обычная ситуация у мобильных операторов и
# части роутеров) прямое соединение не проходит, и звонок просто не
# устанавливается. Поднимите свой coturn (см. DEPLOY.md, раздел «TURN-сервер
# для звонков») и укажите тот же секрет здесь и в static-auth-secret
# coturn'а — креденшелы генерируются на лету и живут час, ничего постоянного
# в код не зашивается.
# TURN_URLS=turn:ваш-домен.example:3478,turns:ваш-домен.example:5349
# TURN_SECRET=длинная-случайная-строка

# Хранилище вложений (фото/видео/голосовые/файлы). Без этого блока всё пишется
# на диск сервера, как раньше, — ничего не ломается. Задайте S3_BUCKET, чтобы
# перевести хранение в S3-совместимое облако (см. server/lib/storage.js).
#
# Значения ниже — под Яндекс Object Storage; для AWS S3 достаточно убрать
# S3_ENDPOINT/S3_REGION (возьмутся дефолты AWS SDK) и указать свой регион, для
# Cloudflare R2 — S3_ENDPOINT вида https://<account_id>.r2.cloudflarestorage.com.
# S3_BUCKET=shalter-uploads
# S3_ACCESS_KEY=...
# S3_SECRET_KEY=...
# S3_ENDPOINT=https://storage.yandexcloud.net
# S3_REGION=ru-central1
# Свой подкаталог в бакете, если он общий с другими проектами:
# S3_PREFIX=shalter
